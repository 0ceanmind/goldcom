{
  "$description": "Goldcom design tokens v1.0 (W3C Design Tokens format). Source of truth for colour, type, spacing, radius, elevation and motion. Values here win over any other file.",
  "color": {
    "brand": {
      "amber":   { "$type": "color", "$value": "#CD864B", "$description": "Logo facet (roof). Identity colour. Never use for body text." },
      "gold":    { "$type": "color", "$value": "#DBA761", "$description": "Logo facet (G + gem). Identity colour. Highlights on dark." },
      "ink":     { "$type": "color", "$value": "#000000", "$description": "Logo wordmark. Primary text on light." }
    },
    "gold": {
      "espresso":   { "$type": "color", "$value": "#3B2A1C", "$description": "Headlines on Sand / light gold gradient." },
      "bronzeDeep": { "$type": "color", "$value": "#62422A", "$description": "Bullion gradient start. Dark campaign backgrounds." },
      "bronze":     { "$type": "color", "$value": "#8A5A2B", "$description": "The only gold-family colour allowed for text/links on light backgrounds (5.5:1 on Cream)." },
      "amber":      { "$type": "color", "$value": "{color.brand.amber}" },
      "bullion":    { "$type": "color", "$value": "#C8943D", "$description": "Web accent: icons, rules, borders, decorative details." },
      "gold":       { "$type": "color", "$value": "{color.brand.gold}" },
      "sand":       { "$type": "color", "$value": "#E8CC73", "$description": "Bullion gradient end. Light gold backgrounds." },
      "spark":      { "$type": "color", "$value": "#F2D46B", "$description": "Action colour. Primary buttons and active states on dark UI. Max 5% of any screen." }
    },
    "neutral": {
      "onyx":      { "$type": "color", "$value": "#151513", "$description": "App background (dark product UI)." },
      "charcoal":  { "$type": "color", "$value": "#1D1D1F", "$description": "Surfaces, nav bars, web dark sections." },
      "graphite":  { "$type": "color", "$value": "#2D2E2B", "$description": "Raised cards, inputs on dark." },
      "slate":     { "$type": "color", "$value": "#3D3E3A", "$description": "Dividers and borders on dark." },
      "stone":     { "$type": "color", "$value": "#9A968C", "$description": "Secondary text on dark (6.2:1 on Onyx)." },
      "stoneDark": { "$type": "color", "$value": "#6B675F", "$description": "Secondary text on light (5.3:1 on Cream)." },
      "mist":      { "$type": "color", "$value": "#E9E1CF", "$description": "Borders and dividers on Cream." },
      "cream":     { "$type": "color", "$value": "#FFF8EA", "$description": "Light canvas, web and print backgrounds." },
      "white":     { "$type": "color", "$value": "#FFFFFF" }
    },
    "semantic": {
      "gainOnDark":  { "$type": "color", "$value": "#3DBE84", "$description": "Price up / success on dark." },
      "lossOnDark":  { "$type": "color", "$value": "#F0605D", "$description": "Price down / error on dark." },
      "gainOnLight": { "$type": "color", "$value": "#1E7F52", "$description": "Price up / success on light." },
      "lossOnLight": { "$type": "color", "$value": "#C2362F", "$description": "Price down / error on light." },
      "info":        { "$type": "color", "$value": "#3AA8E8", "$description": "Informational badges only (e.g. weight tag). Never a brand colour." }
    },
    "role": {
      "dark": {
        "background":    { "$type": "color", "$value": "{color.neutral.onyx}" },
        "surface":       { "$type": "color", "$value": "{color.neutral.charcoal}" },
        "surfaceRaised": { "$type": "color", "$value": "{color.neutral.graphite}" },
        "border":        { "$type": "color", "$value": "{color.neutral.slate}" },
        "textPrimary":   { "$type": "color", "$value": "{color.neutral.white}" },
        "textSecondary": { "$type": "color", "$value": "{color.neutral.stone}" },
        "accent":        { "$type": "color", "$value": "{color.gold.gold}" },
        "action":        { "$type": "color", "$value": "{color.gold.spark}" },
        "onAction":      { "$type": "color", "$value": "{color.brand.ink}" }
      },
      "light": {
        "background":    { "$type": "color", "$value": "{color.neutral.cream}" },
        "surface":       { "$type": "color", "$value": "{color.neutral.white}" },
        "border":        { "$type": "color", "$value": "{color.neutral.mist}" },
        "textPrimary":   { "$type": "color", "$value": "{color.neutral.charcoal}" },
        "textSecondary": { "$type": "color", "$value": "{color.neutral.stoneDark}" },
        "accent":        { "$type": "color", "$value": "{color.gold.bronze}" },
        "action":        { "$type": "color", "$value": "{color.neutral.charcoal}" },
        "onAction":      { "$type": "color", "$value": "{color.gold.spark}" }
      }
    }
  },
  "gradient": {
    "bullion":  { "$type": "gradient", "$value": "linear-gradient(180deg, #62422A 0%, #8A6B41 38%, #D0B366 74%, #EDD175 100%)", "$description": "Signature campaign background (dark bronze top to light gold bottom)." },
    "goldLeaf": { "$type": "gradient", "$value": "linear-gradient(135deg, #F2D46B 0%, #DBA761 55%, #CD864B 100%)", "$description": "Small premium accents only: gem badges, success icons, card edges." },
    "onyxGlow": { "$type": "gradient", "$value": "radial-gradient(120% 80% at 50% 0%, #2D2E2B 0%, #151513 60%)", "$description": "Dark hero / app background with subtle top light." },
    "areaGold": { "$type": "gradient", "$value": "linear-gradient(180deg, rgba(242,212,107,0.28) 0%, rgba(242,212,107,0) 100%)", "$description": "Chart area fill under a rising price line." },
    "areaLoss": { "$type": "gradient", "$value": "linear-gradient(180deg, rgba(240,96,93,0.32) 0%, rgba(240,96,93,0) 100%)", "$description": "Chart area fill under a falling price line." }
  },
  "font": {
    "family": {
      "latin":  { "$type": "fontFamily", "$value": ["Inter", "SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "arabic": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "Noto Sans Arabic", "Segoe UI", "Tahoma", "sans-serif"] },
      "mono":   { "$type": "fontFamily", "$value": ["JetBrains Mono", "SF Mono", "Menlo", "monospace"], "$description": "Serial numbers and transaction IDs only." }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "scale": {
      "display": { "size": "56px", "lineHeight": "64px", "weight": 700, "tracking": "-0.02em" },
      "h1":      { "size": "40px", "lineHeight": "48px", "weight": 700, "tracking": "-0.015em" },
      "h2":      { "size": "32px", "lineHeight": "40px", "weight": 700, "tracking": "-0.01em" },
      "h3":      { "size": "24px", "lineHeight": "32px", "weight": 600, "tracking": "0" },
      "h4":      { "size": "20px", "lineHeight": "28px", "weight": 600, "tracking": "0" },
      "bodyLg":  { "size": "18px", "lineHeight": "28px", "weight": 400, "tracking": "0" },
      "body":    { "size": "16px", "lineHeight": "24px", "weight": 400, "tracking": "0" },
      "small":   { "size": "14px", "lineHeight": "20px", "weight": 400, "tracking": "0" },
      "caption": { "size": "12px", "lineHeight": "16px", "weight": 500, "tracking": "0.01em" },
      "overline":{ "size": "12px", "lineHeight": "16px", "weight": 600, "tracking": "0.08em", "$description": "Latin only, uppercase. Arabic: no uppercase, no tracking." },
      "price":   { "size": "32px", "lineHeight": "40px", "weight": 700, "tracking": "-0.01em", "features": "tnum, lnum" }
    },
    "arabicLineHeightMultiplier": { "$value": 1.15, "$description": "Multiply Latin line-height by this for Arabic text." }
  },
  "space": {
    "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
    "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px"
  },
  "radius": {
    "xs": "6px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "pill": "999px",
    "$description": "sm: chips/inputs/badges · md: buttons · lg: cards · xl: sheets/modals/phone-scale containers · pill: segmented controls, tags"
  },
  "elevation": {
    "dark1":  "0 1px 0 rgba(255,255,255,0.04) inset, 0 2px 8px rgba(0,0,0,0.40)",
    "dark2":  "0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 32px rgba(0,0,0,0.55)",
    "light1": "0 1px 2px rgba(59,42,28,0.06), 0 2px 8px rgba(59,42,28,0.06)",
    "light2": "0 8px 32px rgba(59,42,28,0.12)",
    "sparkGlow": "0 0 0 6px rgba(242,212,107,0.14), 0 8px 24px rgba(242,212,107,0.30)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms", "gleam": "1200ms" },
    "easing":   { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" }
  },
  "logo": {
    "clearspace": { "$value": "1X", "$description": "X = width of the detached gem (≈ 21% of symbol height). Keep X free on all sides." },
    "minWidth": {
      "horizontalDigital": "120px", "horizontalPrint": "30mm",
      "stackedDigital": "72px",     "stackedPrint": "18mm",
      "symbolDigital": "20px",      "symbolPrint": "6mm"
    }
  }
}
