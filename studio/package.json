{
  "name": "goldcom-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Goldcom brand studio: on-brand carousels, posts, animations and videos, connected to Claude Code via MCP.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "studio": "npm run build && npm start",
    "mcp": "node mcp/server.mjs",
    "connect": "node scripts/connect-claude.mjs",
    "test": "node scripts/test-server.mjs smoke",
    "test:ui": "node scripts/test-server.mjs ui",
    "test:workspace": "node scripts/test-server.mjs workspace",
    "test:motion": "node scripts/test-server.mjs motion",
    "test:unit": "node --test tests/regressions.test.mjs tests/creative.test.mjs",
    "test:creative": "node scripts/test-server.mjs creative",
    "lint": "eslint server shared src mcp scripts tests",
    "typecheck": "tsc -p tsconfig.json",
    "test:http": "node scripts/test-server.mjs http"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "^8.19.0",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "opentype.js": "1.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.1",
    "webm-muxer": "5.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
